@model TELFrontendRazor.ViewModels.SideNavViewModel

@using NavigationItemViewModel = TELFrontendRazor.ViewModels.NavigationItemViewModel
@using NavStatus = TELFrontendRazor.ViewModels.NavStatus

@{
    void RenderTick(NavStatus status)
    {
        if (status == NavStatus.Locked)
        {
            <span class="tel-lhs-navigation__lock">
                <svg class="tel-lhs-navigation__icon tel-lhs-navigation__icon--lock"
                     width="18"
                     height="18"
                     viewBox="0 0 18 18"
                     fill="none"
                     xmlns="http://www.w3.org/2000/svg"
                     role="img"
                     aria-label="Locked">
                    <rect class="tel-lhs-navigation__icon-background"
                          x="0.5"
                          y="0.5"
                          width="17"
                          height="17"
                          rx="8.5" />
                    <rect class="tel-lhs-navigation__icon-border"
                          x="0.5"
                          y="0.5"
                          width="17"
                          height="17"
                          rx="8.5" />
                    <path class="tel-lhs-navigation__icon-symbol"
                          d="M7.57143 7.03125V7.875H10.4286V7.03125C10.4286 6.2543 9.78929 5.625 9 5.625C8.21071 5.625 7.57143 6.2543 7.57143 7.03125ZM6.42857 7.875V7.03125C6.42857 5.63379 7.58036 4.5 9 4.5C10.4196 4.5 11.5714 5.63379 11.5714 7.03125V7.875H11.8571C12.4875 7.875 13 8.37949 13 9V12.375C13 12.9955 12.4875 13.5 11.8571 13.5H6.14286C5.5125 13.5 5 12.9955 5 12.375V9C5 8.37949 5.5125 7.875 6.14286 7.875H6.42857Z" />
                </svg>
            </span>
        }
        else if (status == NavStatus.Complete)
        {
            <span class="tel-lhs-navigation__status tel-lhs-navigation__status--complete"
                  data-for="cm_completion"
                  data-value="1">
                <svg class="tel-lhs-navigation__icon tel-lhs-navigation__icon--complete"
                     width="18"
                     height="18"
                     viewBox="0 0 18 18"
                     fill="none"
                     xmlns="http://www.w3.org/2000/svg"
                     role="img"
                     aria-label="Complete">
                    <rect class="tel-lhs-navigation__icon-background"
                          x="0.5"
                          y="0.5"
                          width="17"
                          height="17"
                          rx="8.5" />
                    <rect class="tel-lhs-navigation__icon-border"
                          x="0.5"
                          y="0.5"
                          width="17"
                          height="17"
                          rx="8.5" />
                    <path class="tel-lhs-navigation__icon-symbol"
                          d="M5.5625 9.25095L8.5625 11.7509L12.4375 6.24902"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round" />
                </svg>
            </span>
        }
        else if (status == NavStatus.Unstarted)
        {
            <span class="tel-lhs-navigation__status tel-lhs-navigation__status--unstarted"
                  data-for="cm_completion"
                  data-value="1">
                <svg class="tel-lhs-navigation__icon tel-lhs-navigation__icon--unstarted"
                     width="18"
                     height="18"
                     viewBox="0 0 18 18"
                     fill="none"
                     xmlns="http://www.w3.org/2000/svg"
                     role="img"
                     aria-label="Unstarted">
                    <circle cx="9" cy="9" r="8.5" />
                </svg>
            </span>
        }
    }

    void RenderNavigationItem(
        NavigationItemViewModel item,
        string id,
        int level = 1)
    {
        var hasChildren = item.Children?.Count > 0;
        var isExpanded = hasChildren && item.IsExpanded;

        var childGroupId = $"tel-lhs-nav-collapse-{id}";
        var titleId = $"tel-lhs-nav-section-title-{id}";

        var itemClasses = "tel-lhs-navigation__item";

        if (hasChildren)
        {
            itemClasses += " tel-lhs-navigation__section";
        }

        var linkClasses = "tel-lhs-navigation__link";

        if (hasChildren)
        {
            linkClasses += " tel-lhs-navigation__chevron";

            if (!isExpanded)
            {
                linkClasses += " collapsed";
            }
        }

        if (item.IsLocked)
        {
            linkClasses += " tel-lhs-navigation__link--locked";
        }

        if (item.IsActive)
        {
            linkClasses += " tel-lhs-navigation__link--active";
        }

        var rightGroupClasses = "tel-lhs-navigation__right-group";

        if (item.Statuses.Count <= 1)
        {
            rightGroupClasses += " tel-lhs-navigation__right-group--single";
        }

        <li class="@itemClasses"
            data-id=""
            role="treeitem"
            aria-expanded="@(hasChildren ? isExpanded.ToString().ToLowerInvariant() : null)"
            aria-selected="@item.IsActive.ToString().ToLowerInvariant()">

            @if (hasChildren)
            {
                @if (level > 1)
                {
                    <div class="tel-lhs-navigation__curve"></div>
                }

                <a href=""
                   class="@linkClasses"
                   aria-expanded="@isExpanded.ToString().ToLowerInvariant()"
                   aria-controls="@childGroupId"
                   data-toggle-target="#@childGroupId">

                    <div class="tel-lhs-navigation__left-group">
                        <div class="tel-lhs-navigation__title tel-lhs-navigation__section-title"
                             id="@titleId"
                             role="presentation">

                            <span class="tel-lhs-navigation__chevron-icon tel-lhs-navigation__chevron-icon--collapsed"
                                  aria-hidden="true">
                                <i class="icon fa fa-chevron-right fa-fw"
                                   aria-hidden="true"></i>
                            </span>

                            <span class="tel-lhs-navigation__chevron-icon tel-lhs-navigation__chevron-icon--expanded"
                                  aria-hidden="true">
                                <i class="icon fa fa-chevron-down fa-fw"
                                   aria-hidden="true"></i>
                            </span>

                            @item.Title
                        </div>
                    </div>

                    <div class="@rightGroupClasses">
                        @foreach (var status in item.Statuses)
                        {
                            RenderTick(status);
                        }
                    </div>
                </a>

                <ul id="@childGroupId"
                    class="tel-lhs-navigation__section-content@(isExpanded ? "" : " collapsed")"
                    aria-labelledby="@titleId"
                    role="group">

                    @for (var childIndex = 0; childIndex < item.Children!.Count; childIndex++)
                    {
                        RenderNavigationItem(
                            item.Children[childIndex],
                            $"{id}-{childIndex}",
                            level + 1);
                    }
                </ul>
            }
            else
            {
                <a href="@(item.IsLocked ? "#" : item.Url)"
                   class="@linkClasses">

                    <div class="tel-lhs-navigation__left-group">
                        <div class="tel-lhs-navigation__title"
                             role="presentation">
                            @item.Title
                        </div>
                    </div>

                    <div class="@rightGroupClasses">
                        @foreach (var status in item.Statuses)
                        {
                            RenderTick(status);
                        }
                    </div>
                </a>
            }
        </li>
    }
}

<nav class="tel-lhs-navigation"
     data-component="tel-lhs-navigation"
     data-module="tel-lhs-navigation">

    <button type="button"
            class="nhsuk-button nhsuk-button--secondary-solid tel-lhs-navigation__toggle"
            aria-controls="tel-lhs-nav-content"
            aria-expanded="false">
        <span class="icon-wrapper" aria-hidden="true">
            <i class="icon fa fa-angle-double-right"></i>
        </span>
        <span class="tel-lhs-navigation__toggle-text">Open page menu</span>
    </button>

    <div class="tel-lhs-navigation__content">
        <button type="button"
                class="nhsuk-button nhsuk-button--secondary-solid tel-lhs-navigation__toggle"
                aria-controls="tel-lhs-nav-content"
                aria-expanded="false">
            <span class="icon-wrapper" aria-hidden="true">
                <i class="icon fa fa-angle-double-left"></i>
            </span>
            <span class="tel-lhs-navigation__toggle-text">Close page menu</span>
        </button>

        <ul class="tel-lhs-navigation__tree" role="tree">
            @for (var index = 0; index < Model.Items.Count; index++)
            {
                RenderNavigationItem(
                    Model.Items[index],
                    (index + 1).ToString());
            }
        </ul>
    </div>
</nav>

