<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <AssemblyName>TELFrontendRazor</AssemblyName>
    <Version>1.0.1</Version>
    <EnableDefaultRazorGenerateItems>false</EnableDefaultRazorGenerateItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);frontend-resources\**</DefaultItemExcludes>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  
  <ItemGroup>
    <None Include="Views\Shared\**\*.*" Pack="true" PackagePath="Views\Shared" />
  </ItemGroup>

  <!-- Copy assets directly from node_modules into wwwroot -->
  <ItemGroup>
    <TelCssFiles Include="frontend-resources\node_modules\tel-frontend\dist\main-0.1.0.min.css" />
    <TelCssMap   Include="frontend-resources\node_modules\tel-frontend\dist\main.css.map" />
    <NhsCssFiles Include="frontend-resources\node_modules\nhsuk-frontend\dist\nhsuk\nhsuk-frontend.min.css*" />
    <NhsJsFiles  Include="frontend-resources\node_modules\nhsuk-frontend\dist\nhsuk\nhsuk-frontend.min.js*" />
  </ItemGroup>

  <Target Name="CopyAssetsToWwwroot" BeforeTargets="BeforeBuild" Condition="Exists('frontend-resources\node_modules')">
    <Copy SourceFiles="@(TelCssFiles)" DestinationFiles="wwwroot\css\tel-frontend.min.css" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(TelCssMap)"   DestinationFiles="wwwroot\css\tel-frontend.min.css.map" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NhsCssFiles)" DestinationFolder="wwwroot\css" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NhsJsFiles)"  DestinationFolder="wwwroot\js"  SkipUnchangedFiles="true" />
    <Exec Command="npm run bundle:js"
          WorkingDirectory="frontend-resources" />
  </Target>

  
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.11" />
    <PackageReference Include="NHSUKFrontendRazor" Version="1.0.36" />
  </ItemGroup>

</Project>
