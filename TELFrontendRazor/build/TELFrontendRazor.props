<Project>
    <Target Name="CopyFiles" BeforeTargets="Build">
        <ItemGroup>
            <File Include="$(MSBuildThisFileDirectory)..\Views\Shared\**\*.*" />
            <WwwrootFiles Include="$(MSBuildThisFileDirectory)..\wwwroot\**\*.*" />
        </ItemGroup>
        <Copy SourceFiles="@(File)" DestinationFolder="$(ProjectDir)Views\Shared\%(RecursiveDir)" SkipUnchangedFiles="true" />
        <Copy SourceFiles="@(WwwrootFiles)" DestinationFolder="$(ProjectDir)wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
    </Target>
</Project>